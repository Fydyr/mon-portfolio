# Nom du projet (utilisé pour les noms de conteneurs et Traefik)
NAME=portfolio

# Identifiants MySQL
MYSQL_DATABASE=portfolio
MYSQL_USERNAME=portfolio
MYSQL_PASSWORD=portfolio
MYSQL_ROOT_PASSWORD=rootpw

# Authentification HTTP devant phpMyAdmin (middleware basicAuth de Traefik).
# Sans elle, l'interface est exposée à Internet et ses identifiants MySQL
# peuvent être brute-forcés sans limite.
#
# Format htpasswd : utilisateur:<hash bcrypt>.
#
# ATTENTION : docker compose interprète les $ de cette valeur. Un hash bcrypt
# collé tel quel est silencieusement corrompu ($10$aa... devient $10... car
# $aa est pris pour une variable vide) et l'authentification échoue toujours.
# Il faut DOUBLER chaque $.
#
# Générer la ligne déjà échappée, en une commande :
#     htpasswd -nbB admin 'MotDePasseChoisi' | sed -e 's/\$/\$\$/g'
#
# Si htpasswd n'est pas installé, php fait l'affaire (dispo dans le conteneur app) :
#     php -r 'echo str_replace("$","$$","admin:".password_hash("MotDePasseChoisi", PASSWORD_BCRYPT)),"\n";'
#
# Coller le résultat tel quel ci-dessous, sans guillemets. Le hash doit contenir
# des $$ : PMA_BASIC_AUTH=admin:$$2y$$10$$xxxxxxxx...
PMA_BASIC_AUTH=admin:$$2y$$10$$remplace_moi_par_un_vrai_hash

# Mets true pour forcer la régénération de includes/db.php au prochain boot
DB_REGENERATE=false

# Compte admin de base : créé automatiquement au premier boot si la table user est vide.
# Une fois créé, modifier ADMIN_PASSWORD ici n'a aucun effet (à changer via l'admin du site).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
